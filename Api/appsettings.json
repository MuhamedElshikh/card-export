{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "IdCardReaderDb": "Server=(localdb)\\MSSQLLocalDB;Database=IdCardReaderDb;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Ocr": {
    "MaxConcurrentScans": 1,
    "TessdataPath": ""
  },
  "Storage": {
    "StoreImage": false,
    "Path": "",
    "EncryptionKey": ""
  },
  "RateLimiting": {
    "Scan": {
      "PermitLimit": 10
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
