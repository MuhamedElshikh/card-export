# Copy to .env and set a strong password before running `docker compose up`.
# The password is only used for the local SQL Server container.
SQL_SA_PASSWORD=ChangeMe_Strong!Passw0rd

# Optional: enable encrypted image persistence (default off, see docs/architecture.md)
STORE_IMAGE=false
# Base64 encoded 32 byte AES key, required only when STORE_IMAGE=true
STORAGE_ENCRYPTION_KEY=
